<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Cleartext is permitted solely for local development hosts
     in debug builds (see src/debug/res/xml/network_security_config.xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
