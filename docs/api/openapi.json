{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "critical": {
            "title": "Critical",
            "type": "boolean"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "critical",
          "latency_ms"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Envelope returned for every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Checks",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "description": "ready: all checks pass. degraded: a non-critical dependency (e.g. Qdrant, worker) is down; core features work. not_ready: a critical dependency is down.",
            "enum": [
              "ready",
              "degraded",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "environment",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SystemInfoResponse": {
        "description": "Non-sensitive capabilities the clients use to adapt their UI.",
        "properties": {
          "ai_processing_policy": {
            "enum": [
              "disabled",
              "local_only",
              "third_party_allowed"
            ],
            "title": "Ai Processing Policy",
            "type": "string"
          },
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "google_oauth_configured": {
            "title": "Google Oauth Configured",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "environment",
          "ai_processing_policy",
          "google_oauth_configured"
        ],
        "title": "SystemInfoResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Private AI-powered personal document vault.",
    "title": "Saige Vault API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/system/info": {
      "get": {
        "operationId": "system_info_api_v1_system_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Server capabilities",
        "tags": [
          "system"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Returns 200 while the process is able to serve requests. Performs no I/O.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "system"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "A critical dependency is down"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "system"
        ]
      }
    }
  }
}
