# Saige Vault — local development configuration.
# Copy to .env and fill in values. NEVER commit .env.
# Production secrets must come from a secret manager, not from files.

# ---- General ----
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_USER=saige
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=saige_vault
DATABASE_URL=postgresql+asyncpg://saige:change-me-local-only@localhost:5432/saige_vault

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# 32-byte base64 key for encrypting OAuth tokens at rest.
# Generate with: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Google OAuth / Drive ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---- AI providers (configured in later phases) ----
# Providers: anthropic | openai | google | ollama | none
AI_PROCESSING_POLICY=disabled  # disabled | local_only | third_party_allowed
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
RERANKER_PROVIDER=none
OCR_PROVIDER=tesseract

# ---- Web (exposed to browser — never put secrets here) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
