# Saige Vault — local development configuration.
# Copy to .env and fill in values. NEVER commit .env.
# Production secrets must come from a secret manager, not from files.

# ---- General ----
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- MongoDB ----
# Local (docker compose) or MongoDB Atlas. Put the database name after the host.
MONGODB_URI=mongodb://localhost:27017/saige_vault

# ---- File storage: Cloudflare R2 ----
# R2 → Manage API tokens → Create (Object Read & Write). Leave empty locally and
# set MEMORY_STORAGE=true to keep files in memory instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saige-vault
MEMORY_STORAGE=true

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# 32-byte base64 key for encrypting OAuth tokens at rest.
# Generate with: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Google OAuth / Drive ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the WEB origin (Next.js proxies /api/* to the API). Register this exact
# URI in Google Cloud Console > APIs & Services > Credentials > your OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ---- Auth ----
# Development-only email sign-in without Google. Refused when APP_ENV=production.
DEV_LOGIN_ENABLED=true
# Secure cookies need HTTPS. Leave empty for automatic (on in production).
COOKIE_SECURE=
# Email + password sign-in (Argon2id, optional two-step verification). See ADR-0012.
PASSWORD_LOGIN_ENABLED=true
# Refuse passwords found in data breaches (Have I Been Pwned, k-anonymity).
PASSWORD_BREACH_CHECK=true

# ---- AI providers (configured in later phases) ----
# Providers: anthropic | openai | google | ollama | none
AI_PROCESSING_POLICY=disabled  # disabled | local_only | third_party_allowed
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
RERANKER_PROVIDER=none
OCR_PROVIDER=tesseract

# ---- Web ----
# Where the Next.js server proxies /api/* (read at build time).
API_PROXY_TARGET=http://localhost:8000
